{"url": "https://jobs.eni.com/en/sites/CX_1004", "status": 200, "text": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n    <head>\n        <meta charset=\"utf-8\"></meta>\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=1, minimum-scale=1\"></meta>\n        \n                \n                        \n                   \n            <meta property=\"og:title\" content=\"EniJobs Careers\"/>\n            <meta property=\"og:description\" content=\"A world of professional opportunities\"/>\n                            <meta property=\"og:image\" content=\"https://www.eni.com/visual-design/enijobs/images/opengraph-orc-new-OG.jpg\"/>\n                        \n            \n                        <meta property=\"og:type\" content=\"website\"/>\n                        \n            <meta property=\"og:site_name\" content=\"EniJobs\"/>\n            <meta name=\"twitter:card\" content=\"summary_large_image\">\n            <title>EniJobs</title>\n        \n\t\n                                                   <base href=\"/en/sites/CX_1004\"  data-apibaseurl=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443\" data-fahosturl=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443\" data-vanitybaseurl=\"https://jobs.eni.com/\" data-sitenumber=\"CX_1004\" data-shorturl='{\"challengeFlag\":null,\"url\":null}' data-customjs-src='https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmUI/CandExpStatic/js/ce-custom.js?themeNumber=1011&themeVersion=1&brandVersion=7'/>\n                                           \n        <link rel=\"icon\" sizes=\"16x16\" type=\"image/png\" title=\"favicon\" href=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmRestApi/CandidateExperience/siteFavicon/favicon-16x16.png?siteNumber=CX_1004&size=16x16\"></link>\n        <link rel=\"icon\" sizes=\"144x144\" type=\"image/png\" title=\"favicon\" href=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmRestApi/CandidateExperience/siteFavicon/favicon-144x144.png?siteNumber=CX_1004&size=144x144\"></link>\n        <link rel=\"icon\" sizes=\"152x152\" type=\"image/png\" title=\"favicon\" href=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmRestApi/CandidateExperience/siteFavicon/favicon-152x152.png?siteNumber=CX_1004&size=152x152\"></link>\n\n        <link rel=\"apple-touch-icon\" sizes=\"152x152\" type=\"image/png\" title=\"favicon\" href=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmRestApi/CandidateExperience/siteFavicon/favicon-152x152.png?siteNumber=CX_1004&size=152x152\"></link>\n\n        \n        <link rel=\"stylesheet\" href=\"https://static.oracle.com/cdn/jet/19.0.0/default/css/redwood/oj-redwood-min.css\">\n        <link rel=\"stylesheet\" href=\"https://static.oracle.com/cdn/fa/oj-hcm-ce/2604.20.261590626/css/main-minimal.css\">\n         \n        <link rel=\"stylesheet\" title=\"cx-custom\" data-custom-css href=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmUI/CandExpStatic/css/ce-custom.css?themeNumber=1011&lang=en&themeVersion=1&brandVersion=7&brandTlVersion=15&siteNumber=CX_1004\"></link>\n\n        <script >\n                                            window.VanityUrlEnabled = true;\n                \n                                                    window.VanityUrlUseReverseProxy = true;\n                                    </script>\n        <script src=\"https://static.oracle.com/cdn/fa/oj-hcm-ce/2604.20.261590626/js/main-minimal.js\"  defer></script>\n        \t<script id=\"custom-js\" src=\"https://fa-evkm-saasfaprod1.fa.ocs.oraclecloud.com:443/hcmUI/CandExpStatic/js/ce-custom.js?themeNumber=1011&themeVersion=1&brandVersion=7\" defer data-custom-js></script>      \n                <style id=\"custom-css\" >\n            [dir] .app-header {\n    margin: 20px;\n}\n\n[dir] .app__top {\n    background-color: #040832;\n    padding: 6px;\n}\n\n\n[dir] .search-box-compact__button {\n    background-color: #FFD300;\n}\n\n/* Qui per modificare il colore del testo in alto a destra*/\n[dir] .app-header-horizontal span {\n    color: white;\n}\n\n/*Questo per cambiare il colore al testo dei filtri per le categorie di job offer*/\n[dir] .categories-list__button {\n    color: #040832;\n}\n\n/*Per cambiare il colore alla lente del search*/\n[dir] .icon-search-thin {\n    color: #040832;\n}\n\n/*Per cambiare il colore del testo dentro 'Join U'*/\n[dir] .button--primary {\n    color: #040832;\n}\n\n\n/*Coockies Section*/\n/*Button Color*/\n.cookie-consent__actions {\n    color: #0958a5;\n}\n\n/*Testo (Tranne Learn More)Color*/\n.cookie-consent__abstract-message {\n    color: #0958a5;\n}\n\n/*Learn More text*/\n.cookie-consent__read-more {\n    color: #040832;\n}\n\n/*Bordo del box*/\n.cookie-consent__content {\n    color: #040832;\n}\n\n/*End Coockies Section*/\n\n/*Todino counter nei filtri Colore*/\n[dir] .search-filters__pill-counter {\n    background-color: #0958a5;\n}\n\n/*Show More Result*/\n[dir] .search-pagination button {\n    color: #040832;\n}\n\n/*Icone mappa e lista di quando selezioni i jobs*/\n[dir] [class^=\"search-job-results__\"],\n/* [dir] button.search-results-sorting__selector span, */\n[dir] .search-results-sorting__selector-icon {\n    color: #0958a5 !important;\n}\n\n/*Testo filtri quando selezionato un valore*/\n[dir] .search-filters__pill-title {\n    color: #040832 !important;\n}\n\n/*Per cambiare selezionatore lingua*/\n/*.language-select .language-select__menu .language-select__menu-item-selected { \n    color: #FFFFFF ;\n}*/\n\n[dir] .language-select__menu-item-selected {\n    color: white;\n}\n\n[dir] .internal-user-login-button__display-text {\n    color: white !important;\n}\n\n\n/* TEST LUCA */\n\n/* mobile view */\n@media screen and (max-width: 767px) {\n    [dir] .media-element--image {\n        padding-top: 20px !important;\n    }\n\n    footer .cc-element {\n        padding: 10px !important;\n    }\n\n    [dir] .app-toggle-menu__container {\n        color: #fff !impo