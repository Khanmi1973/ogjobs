apply-flow__content .apply-flow-pagination__buttons .theme-color-1:hover,\n.cs-sign-in__container .buttons-bar__inner .theme-color-1:hover {\n    background-color: #E9BF04;\n    border: 0;\n}\n\n.apply-flow__content .apply-flow-pagination__buttons .text-color-secondary::before,\n.cs-sign-in__container .buttons-bar__inner .text-color-secondary::before {\n    border-color: #040832;\n}\n\n.apply-flow__content .apply-flow-pagination__buttons .text-color-secondary:hover::before,\n.cs-sign-in__container .buttons-bar__inner .text-color-secondary:hover::before {\n    border-color: #0958A5;\n}\n\n.apply-flow__content h1,\n.cs-sign-in__container h1 {\n    color: #040832;\n    font-weight: bold;\n    font-size: 32px;\n}\n\n.apply-flow__content .apply-flow-dialog__text,\n.cs-sign-in__container .apply-flow-dialog__text {\n    color: #222222;\n    font-size: 16px;\n}\n\n.apply-flow__content .apply-flow-dialog__form label,\n.cs-sign-in__container .apply-flow-dialog__form label {\n    color: #040832;\n    font-size: 14px;\n    font-weight: bold;\n}\n\n.apply-flow__content [dir] .input-row__control,\n.cs-sign-in__container [dir] .input-row__control {\n    border-color: #878787;\n    background-color: #FFFFFF;\n}\n\n.apply-flow-block__title {\n    color: #040832;\n}\n\n.apply-flow-block__instructions {\n    color: #222222;\n}\n\n.apply-flow-block__form-list .input-row__label{\n    color: #040832;\n}\n\n\n[dir] .input-row__control,\n[dir] .input-row__select.oj-select,\n[dir] .input-row__search-input,\n[dir] .input-row__listbox .oj-text-field .oj-text-field-container,\n[dir] .cx-select-single,\n[dir] .input-row-composite__inputs,\n[dir] .apply-flow-input-checkbox__button {\n    background: hsla(0, 0%, 100%, .01);\n    border: 1px solid hsla(0, 0% , 53%, 1);\n    color: #040832;\n}\n\n\n\n[dir] .input-row__control:focus-within,\n[dir] .input-row__select.oj-select:focus-within,\n[dir] .input-row__search-input:focus-within,\n[dir] .input-row__listbox .oj-text-field .oj-text-field-container:focus-within,\n[dir] .cx-select-single:focus-within,\n[dir] .input-row-composite__inputs:focus-within {\n    background: hsla(0, 0%, 96%, 1) !important;\n    border: 1px solid hsla(210, 90%, 34% , 1) !important;\n}\n\n.datepicker-row__input .input-row__control,\n.datepicker-row__input .input-row__control:focus-within,\n.phone-row__number .input-row__control,\n.phone-row__number .input-row__control:focus-within {\n    background: inherit !important;\n    border: inherit !important;\n}\n\n\n/* COOKIE CONSENT */\n/* .cookie-consent__actions > .cookie-consent__button {\n    display: none !important;\n}\n\n.cookie-consent__actions > .cookie-consent__button ~ .cookie-consent__button {\n    display: inherit !important;\n}\n\n[dir] .app-dialog__footer button[data-bind=\"click: accept\"] {\n    display: none !important;\n} */\n\n.cookie-consent__actions .accept {\n    display: none !important;\n}\n\n\n/* WORK AROUND IOS */\n\n.search-box-compact__input {\n  align-content: normal;\n}\n\n/* Status candidate remove */\n\n[dir] .cs-job-status .cs-job-status__label  {\n    display: none;\n}\n[dir] .cs-job-status .cs-job-status__value  {\n    display: none;\n}\n\n\n        </style>\n        </head>\n    <body class=\"app-loading font-family-primary\" data-bind=\"loadingIndicator, a11y.toggleFocusIndicator, bodyScrolledDown, currentRoute\">\n        <div class=\"preload\" aria-hidden=\"true\">\n            <div class=\"preload__icons\"></div>\n            <div class=\"preload__primary-font\"></div>\n            <div class=\"preload__secondary-font\"></div>\n        </div>\n        <div class=\"app-loading-spinner\"></div>\n        <div class=\"app\" data-bind=\"view: 'layout'\"></div>\n                <script type=\"text/html\" id=\"custom-footer\" >\n            <div class=\"cc-row\">\n    <div class=\"cc-row__content cc-columns-count-2\">\n        <div class=\"cc-column cc-column--2-3\" style=\"background-color: rgb(4, 8, 50);\">\n\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element-media cc-element-media--align-left null\">\n                    <a target=\"_blank\">\n                        <img class=\"media-element media-element--image media-element--mobile\" alt=\"Eni\"\n                            src=\"https://www.eni.com/visual-design/enijobs/images/Logo%20ENI%20nuovo_footer.png\"\n                            title=\"Eni\" width=\"\">\n\n                        <img class=\"media-element media-element--image\" alt=\"Eni\"\n                            src=\"https://www.eni.com/visual-design/enijobs/images/Logo%20ENI%20nuovo_footer.png\"\n                            title=\"Eni\" width=\"110\" style=\"\n                        margin-top: 50px;\n                        margin-right: 50px;\n                        margin-left: 37px;\n                        padding-left: 43px;\">\n                    </a>\n\n                </div>\n                <div class=\"cc-element cc-element--rich-text basic-formatter cc-paragraph\">\n                    <p class=\"\"><span style=\"line-height:28px; font-size: 16px;\"><span\n                                style=\"color:#ffffff;\">We are an energy company. We concretely support a just energy\n                                transition, with the objective of preserving our planet and promoting an efficient and\n                                sustainable access to energy for all. Our work is based on passion and innovation, on\n                                our unique strengths and skills, on the equal dignity of each person, recognizing\n                                diversity as a key value for human development, on the responsibility, integrity and\n                                transparency of our actions. We believe in the value of long term partnerships with the\n                                countries and communities where we operate, bringing long-lasting prosperity for\n                                all.</span></span></p>\n                </div>\n\n            </div>\n        </div>\n        <div class=\"cc-column cc-column--1-3\" style=\"background-color: rgb(4, 8, 50);\">\n            <div class=\"cc-column__content\">\n\n            </div>\n        </div>\n\n    </div>\n</div>\n<div class=\"cc-row\">\n    <div class=\"cc-row__content cc-columns-count-1\">\n        <div class=\"cc-column cc-column--default\" style=\"background-color: rgb(4, 8, 50);\">\n\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element--rule cc-rule--align-left null\"\n                    style=\"background-color: rgb(4, 8, 50);\">\n                    <div class=\"cc-element-rule__line\" style=\"width: 100%; background-color: rgb(255, 255, 255);\"></div>\n                </div>\n\n            </div>\n        </div>\n\n    </div>\n</div>\n<div class=\"cc-row\">\n    <div class=\"cc-row__content cc-columns-count-4\">\n        <div class=\"cc-column cc-column--default\" style=\"background-color: rgb(4, 8, 50); padding-bottom: 40px;\">\n\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element--rich-text basic-formatter cc-paragraph\">\n                    <p><span style=\"color:#FFD300; font-size: 14px;\"><strong>LEGAL HEADQUARTER</strong></span></p>\n                    <p style=\"padding: 0;\"><span style=\"color:#ffffff; font-size: 14px; line-height:20px; \">Piazzale Enrico Mattei, 1 00144\n                            Roma</span></p>\n                </div>\n\n            </div>\n        </div>\n        <div class=\"cc-column cc-column--default\" style=\"background-color: rgb(4, 8, 50); padding-bottom: 40px;\">\n\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element--rich-text basic-formatter cc-paragraph\">\n                    <p><span style=\"color:#FFD300; font-size: 14px;\"><strong>SHARE CAPITAL</strong></span></p>\n                    <p style=\"padding: 0;\"><span style=\"color:#ffffff; font-size: 14px; line-height:20px; \">\u20ac 4.005.358.876,00 i.v.</span>\n                    </p>\n                </div>\n\n            </div>\n        </div>\n        <div class=\"cc-column cc-column--default\" style=\"background-color: rgb(4, 8, 50); padding-bottom: 40px;\">\n\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element--rich-text basic-formatter cc-paragraph\">\n                    <p><span style=\"color:#FFD300; font-size: 14px;\"><strong>BRANCH OFFICES</strong></span></p>\n                    <p style=\"padding: 0;\"><span style=\"color:#ffffff; font-size: 14px; line-height:20px; \">Via Emilia, 1 e Piazza Ezio\n                            Vanoni, 1 20097 San Donato Milanese (MI)</span></p>\n                </div>\n\n            </div>\n        </div>\n        <div class=\"cc-column cc-column--default\" style=\"background-color: rgb(4, 8, 50); padding-bottom: 40px;\">\n\n            <div class=\"cc-column__content\">\n                <div class=\"cc-element cc-element--rich-text basic-formatter cc-paragraph\">\n                    <p><span style=\"color:#FFD300; font-size: 14px;\"><strong>C. TAX AND BUSINESS REGISTER OF\n                                ROME</strong></span></p>\n                    <p style=\"padding: 0;\"><span style=\"color:#ffffff; font-size: 14px; line-height:20px; \">n. 00484960588</span></p>\n                </div>\n\n            </div>\n        </div>\n\n    </div>\n</div>\n        </script>\n       \n    </body>\n</html>\n", "headers": {"date": "Fri, 21 Aug 2026 07:45:34 GMT", "content-type": "text/html; charset=utf-8", "content-length": "20587", "connection": "close", "x-powered-by": "Express", "location": "", "etag": "W/\"506b-oKksspvqhTjExtJ0xgqPxJN1WDY\""}}