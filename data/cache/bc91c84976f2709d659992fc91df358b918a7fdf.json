{"url": "https://app.beehire.com/career/aldelia", "status": 200, "text": "<!DOCTYPE html>\n<html class=\"career\" lang=\"en\" translate=\"no\">\n  <head>\n    <!-- title-->\n    <title>Career Page | Beehire</title>\n    <!-- seo-->\n    <!-- metadata-->\n    <meta name=\"viewport\" content=\"initial-scale=1.0, user-scalable=no\">\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta property=\"fb:app_id\" content=\"362781804609985\">\n    <meta property=\"og:title\" id=\"ogtitle\" content=\"Our job offers\">\n    <meta property=\"og:url\" id=\"ogurl\" content=\"https://app.beehire.com/career/aldelia\">\n    <meta property=\"og:type\" id=\"ogtype\" content=\"website\">\n    <meta property=\"og:image:width\" content=\"100\">\n    <meta property=\"og:image:height\" content=\"100\">\n    <meta property=\"og:description\" id=\"ogdescription\" content=\"Discover job openings at Aldelia and join the team!\">\n    <meta property=\"og:image\" id=\"ogimage\" content=\"/uploads/647f3c24b64b3b2d153bc2a9-interview-hero-XCmXErMMj.jpg\">\n    <meta name=\"twitter:card\" content=\"summary\">\n    <meta name=\"twitter:title\" content=\"Our job offers\">\n    <meta name=\"twitter:description\" content=\"Discover job openings at Aldelia and join the team!\">\n    <meta name=\"twitter:image\" content=\"https://app.beehire.com/uploads/647f3c24b64b3b2d153bc2a9-interview-hero-XCmXErMMj.jpg\">\n    <!-- css-->\n    <link rel=\"stylesheet\" href=\"/styles/main.css\" id=\"maincss\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.css\">\n    <link rel=\"stylesheet\" href=\"https://api.mapbox.com/mapbox-gl-js/v2.14.0/mapbox-gl.css\">\n    <link rel=\"stylesheet\" href=\"https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v4.7.2/mapbox-gl-geocoder.css\">\n    <!-- apple icons-->\n    <link rel=\"mask-icon\" href=\"/favicons/safari-pinned-tab.svg\" color=\"black\">\n    <link rel=\"apple-touch-icon\" href=\"/favicons/apple-touch-icon.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"/favicons/apple-touch-icon.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"/favicons/apple-touch-icon.png\">\n    <link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"/favicons/apple-touch-icon.png\">\n    <link rel=\"icon\" href=\"/favicons/favicon.ico\" type=\"image/x-icon\">\n    <link rel=\"shortcut icon\" href=\"/favicons/favicon.ico\" type=\"image/x-icon\">\n    <link rel=\"shortcut icon\" href=\"/favicons/favicon.ico\" type=\"image/vnd.microsoft.icon\">\n    <script src=\"/language\"></script><!-- Google Maps JavaScript API -->\n<!-- Used for the \"places\" plugin -->\n    <script>\n      (g=>{var h,a,k,p=\"The Google Maps JavaScript API\",c=\"google\",l=\"importLibrary\",q=\"__ib__\",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement(\"script\"));e.set(\"libraries\",[...r]+\"\");for(k in g)e.set(k.replace(/[A-Z]/g,t=>\"_\"+t[0].toLowerCase()),g[k]);e.set(\"callback\",c+\".maps.\"+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+\" could not load.\"));a.nonce=m.querySelector(\"script[nonce]\")?.nonce||\"\";m.head.append(a)}));d[l]?console.warn(p+\" only loads once. Ignoring:\",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({\n        key: \"AIzaSyAyksE2Sto35Y7k9X9E9XYhjyzZ181esyY\",\n        v: \"weekly\",\n        // Use the 'v' parameter to indicate the version to use (weekly, beta, alpha, etc.).\n        // Add other bootstrap parameters as needed, using camel case.\n        libraries: 'places'\n      });\n      google.maps.importLibrary(\"maps\");\n    </script>\n    <script src=\"https://api.mapbox.com/mapbox-gl-js/v2.14.0/mapbox-gl.js\"></script>\n    <script src=\"https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v4.7.2/mapbox-gl-geocoder.min.js\"></script>\n  </head>\n  <body class=\"app-wrapper\" ng-app=\"app\" ng-cloak>\n    <div class=\"notification-banner__row\" id=\"recruiter-banner\">\n      <div class=\"notification-banner\" ng-style=\"{ 'background-color': $root.recruiterBannerBgColor, 'color': $root.recruiterBannerTextColor }\"><span ng-bind-html=\"$root.recruiterBannerMessage\" ng-style=\"{'color': $root.recruiterBannerTextColor}\"></span></div>\n    </div>\n    <!--if lt IE 7\n    p.browsehappy\n    \t|You are using an\n    \tstrong\n    \t\t|outdated browser\n    \t|. Please\n    \ta(href=\"http://browsehappy.com/\")\n    \t\t|upgrade your browser\n    \t|to improve your experience.\n    -->\n    <!-- toaster from angularjs-toaster-->\n    <toaster-container toaster-options=\"{'time-out': 10000}\"></toaster-container>\n    <div id=\"onboarding-widget\"></div>\n    <!-- header-->\n    <style type=\"text/css\">\n      #loader-wrapper {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        z-index: 99999;\n        background: white;\n        -webkit-transition: all .3s ease-out;\n        transition: all .3s ease-out;\n      }\n      \n      #loader-wrapper.loaded {\n        opacity: 0;\n      }\n      \n        /*\n          Spinner animation\n        */\n      \n        #loader {\n          display: block;\n          position: relative;\n          left: 50%;\n          top: 50%;\n          width: 150px;\n          height: 150px;\n          margin: -75px 0 0 -75px;\n          border-radius: 50%;\n          border: 3px solid transparent;\n          border-top-color: #FFB700;\n      \n          -webkit-animation: spin 2s linear infinite; /* Chrome, Opera 15+, Safari 5+ */\n          animation: spin 2s linear infinite; /* Chrome, Firefox 16+, IE 10+, Opera */\n      \n          z-index: 1001;\n        }\n      \n        #loader:before {\n          content: \"\";\n          position: absolute;\n          top: 5px;\n          left: 5px;\n          right: 5px;\n          bottom: 5px;\n          border-radius: 50%;\n          border: 3px solid transparent;\n          border-top-color: #e74c3c;\n      \n          -webkit-animation: spin 3s linear infinite; /* Chrome, Opera 15+, Safari 5+ */\n          animation: spin 3s linear infinite; /* Chrome, Firefox 16+, IE 10+, Opera */\n        }\n      \n        #loader:after {\n          content: \"\";\n          position: absolute;\n          top: 15px;\n          left: 15px;\n          right: 15px;\n          bottom: 15px;\n          border-radius: 50%;\n          border: 3px solid transparent;\n          border-top-color: #f9c922;\n      \n          -webkit-animation: spin 1.5s linear infinite; /* Chrome, Opera 15+, Safari 5+ */\n          animation: spin 1.5s linear infinite; /* Chrome, Firefox 16+, IE 10+, Opera */\n        }\n      \n        @-webkit-keyframes spin {\n          0% {\n            -webkit-transform: rotate(0deg); /* Chrome, Opera 15+, Safari 3.1+ */\n            -ms-transform: rotate(0deg); /* IE 9 */\n            transform: rotate(0deg); /* Firefox 16+, IE 10+, Opera */\n          }\n          100% {\n            -webkit-transform: rotate(360deg); /* Chrome, Opera 15+, Safari 3.1+ */\n            -ms-transform: rotate(360deg); /* IE 9 */\n            transform: rotate(360deg); /* Firefox 16+, IE 10+, Opera */\n          }\n        }\n      \n        @keyframes spin {\n          0% {\n            -webkit-transform: rotate(0deg); /* Chrome, Opera 15+, Safari 3.1+ */\n            -ms-transform: rotate(0deg); /* IE 9 */\n            transform: rotate(0deg); /* Firefox 16+, IE 10+, Opera */\n          }\n          100% {\n            -webkit-transform: rotate(360deg); /* Chrome, Opera 15+, Safari 3.1+ */\n            -ms-transform: rotate(360deg); /* IE 9 */\n            transform: rotate(360deg); /* Firefox 16+, IE 10+, Opera */\n          }\n        }\n      \n      \n      \n      .spinner-loading-page {\n        width: 40px;\n        height: 40px;\n      \n        left: 50%;\n        top: 50%;\n      \n        margin: -20px 0 0 -20px;\n      \n        position: relative;\n        /* margin: 100px auto; */\n      }\n      \n      .double-bounce1, .double-bounce2 {\n        width: 100%;\n        height: 100%;\n        border-radius: 50%;\n        background-color: #FFB700;\n        opacity: 0.6;\n        position: absolute;\n        top: 0;\n        left: 0;\n      \n        -webkit-animation: sk-bounce 2.0s infinite ease-in-out;\n        animation: sk-bounce 2.0s infinite ease-in-out;\n      }\n      \n      .double-bounce2 {\n        -webkit-animation-delay: -1.0s;\n        animation-delay: -1.0s;\n      }\n      \n      @-webkit-keyframes sk-bounce {\n        0%, 100% { -webkit-transform: scale(0.0) }\n        50% { -webkit-transform: scale(1.0) }\n      }\n      \n      @keyframes sk-bounce {\n        0%, 100% {\n          transform: scale(0.0);\n          -webkit-transform: scale(0.0);\n        } 50% {\n          transform: scale(1.0);\n          -webkit-transform: scale(1.0);\n        }\n      }\n      \n    </style>\n    <div id=\"loader-wrapper\">\n      <div class=\"spinner-loading-page\">\n        <div class=\"double-bounce1\"></div>\n        <div class=\"double-bounce2\"></div>\n      </div>\n    </div>\n    <!-- printout over the body element-->\n    <!-- contents-->\n    <div class=\"career-app__container container-fluid\" id=\"js-add-career-font\" ng-controller=\"CareerCtrl\">\n      <div class=\"notification-nav-wrapper\">\n        <div class=\"notification-banner__row\" id=\"candidate-banner\">\n          <div class=\"notification-banner\" id=\"candidate-banner\" ng-style=\"{ 'background-color': $root.candidateBannerBgColor, 'color': $root.candidateBannerTextColor }\"><span ng-bind-html=\"$root.candidateBannerMessage\" ng-style=\"{'color': $root.candidateBannerTextColor}\"></span></div>\n        </div>\n        <section class=\"career__nav\" ng-controller=\"CareerHeaderCtrl\" ng-style=\"{ &quot;background-color&quot;: employerBranding.customization.navbarOpacity || employerBranding.customization.navbarOpacity === 0 ? &quot;hsla(0, 0%, 100%, &quot; + (employerBranding.customization.navbarOpacity)/100 + &quot;)&quot; : undefined }\">\n          <nav class=\"nav__container\"><span class=\"navbar-toggle\" id=\"js-navbar-toggle\" ng-click=\"toggleNavbar()\"><i class=\"fas fa-bars\"></i></span><a class=\"nav-logo\" href=\"{{employerBranding.companyInformation.websiteUrl}}\" target=\"_blank\" ng-style=\"!employerBranding.companyInformation.websiteUrl &amp;&amp; {'pointer-events':'none'}\"><img ng-if=\"employerBranding.customization.logo\" ng-src=\"{{employerBranding.customization.logo}}\">\n              <div class=\"nav__no-logo\" ng-if=\"!employerBranding.customization.logo\">{{employerBranding.companyInformation.name}}</div></a>\n            <ul class=\"nav-links\" id=\"js-menu\">\n              <li ng-repeat=\"navbar in careerNavbarOptions\"><a class=\"nav-link\" ng-if=\"navbar.elementId\" ng-style=\"customization.navbarFontColor\" ng-click=\"scrollToSection(&quot;#&quot;+ navbar.elementId, navbar.scrollWindow)\">{{ navbar.text | translate}}</a><a class=\"nav-link\" ng-if=\"navbar.href\" ng-style=\"customization.navbarFontColor\" href=\"{{navbar.href}}\">{{ navbar.text | translate}}</a></li>\n              <li><a class=\"nav-link nav__candidate-area\" href=\"/candidate-area\" ng-style=\"customization.navbarFontColor\">{{texts.candidate_profile_space_title | translate}}</a></li>\n              <li><a class=\"nav-link nav__lang\" dropdown-menu=\"ddLangs\" dropdown-model=\"{}\" dropdown-item-label=\"text\" dropdown-onchange=\"changeVisitorLanguage(selected.value)\" ng-style=\"customization.navbarFontColor\">{{texts._SHORT[visitorLang]}}</a></li>\n            </ul>\n          </nav>\n        </section>\n      </div>\n      <section class=\"row\" id=\"career__header\">\n        <div class=\"col-12 section-banner interview_hero_default-background\" ng-style=\"{ &quot;background-image&quot;: (employerBranding.customization.bannerImage ? &quot;url(&quot; + employerBranding.customization.bannerImage + &quot;)&quot; : false), color: employerBranding.customization.fontColor || false }\">\n          <video class=\"career__banner-video\" ng-show=\"employerBranding.customization.bannerVideo\" autoplay playsinline muted loop vg-src=\"employerBranding.customization.bannerVideo | videoClipSrc\"></video>\n          <div class=\"section-banner-overlay\" ng-style=\"{ &quot;background-color&quot;: employerBranding.customization.bannerOverlayOpacity || employerBranding.customization.bannerOverlayOpacity === 0 ? &quot;rgba(0, 0, 0, &quot; + (employerBranding.customization.bannerOverlayOpacity)/100 + &quot;)&quot; : undefined }\">\n            <div class=\"section-content\">\n              <h1 class=\"interview_hero_title custom-background interview-welcome__banner-title\" ng-show=\"employerBranding.careerPage.title &amp;&amp; employerBranding.careerPage.title[visitorLang]\">{{employerBranding.careerPage.title[visitorLang]}}</h1>\n              <h1 class=\"interview_hero_title custom-background interview-welcome__banner-title\" ng-show=\"!(employerBranding.careerPage.title &amp;&amp; employerBranding.careerPage.title[visitorLang])\">{{texts.career_join_us | translate}}</h1>\n              <div class=\"section-banner__detail section-content__center\" ng-show=\"campaigns.length\"><a class=\"btn career_cta header__cta\" ng-click=\"scrollToSection(&quot;#career__jobs&quot;)\">{{texts.career_nav_see_jobs | translate}}</a></div><a class=\"btn btn--next-section\" href=\"\" ng-click=\"scrollToSection('#career__jobs')\"></a>\n            </div>\n          </div>\n        </div>\n      </section>\n            <section class=\"career-section\" ng-repeat=\"section in employerBranding.careerPage.sections | filter: {location:&quot;beforeJobs&quot;} | filter:sectionExistsInVisitorLanguage | filter:{isPublished:true} track by $index\" ng-class=\"{&quot;career__banner-image&quot;: (section.arrangement === &quot;imageBanner&quot;), &quot;career__banner-video&quot;: (section.arrangement === &quot;videoBanner&quot;)}\">\n              <div class=\"scroll-anchor\" ng-attr-id=\"beforeJobs{{$index}}\"></div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;onlyMedia&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}} </h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-8 justify-content-center\"><img class=\"career__img\" ng-if=\"section.images[0][0].filename\" ng-src=\"{{section.images[0][0].filename}}\">\n                    <video class=\"career__video\" ng-if=\"section.video[0].videoClipId\" controls vg-src=\"section.video[0].videoClipId | videoClipSrc\"></video>\n                  </div>\n                </div>\n              </div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;textThenMedia&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}}</h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-6 mb-3 mb-lg-0\">\n                    <div class=\"description__text\" ng-bind-html=\"section.text[visitorLang]\"></div>\n                  </div>\n                  <div class=\"career__subsection col-12 col-lg-6\"><img class=\"career__img\" ng-if=\"section.images[0][0].filename\" ng-src=\"{{section.images[0][0].filename}}\">\n                    <video class=\"career__video\" ng-if=\"section.video[0].videoClipId\" controls vg-src=\"section.video[0].videoClipId | videoClipSrc\"></video>\n                  </div>\n                </div>\n              </div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;mediaThenText&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}}</h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-6 mb-3 mb-lg-0\"><img class=\"career__img\" ng-if=\"section.images[0][0].filename\" ng-src=\"{{section.images[0][0].filename}}\">\n                    <video class=\"career__video\" ng-if=\"section.video[0].videoClipId\" controls vg-src=\"section.video[0].videoClipId | videoClipSrc\"></video>\n                  </div>\n                  <div class=\"career__subsection col-12 col-lg-6\">\n                    <div class=\"description__text\" ng-bind-html=\"section.text[visitorLang]\"></div>\n                  </div>\n                </div>\n              </div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;onlyText&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}}</h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-8 justify-content-center\">\n                    <div class=\"description__text\" ng-bind-html=\"section.text[visitorLang]\"></div>\n                  </div>\n                </div>\n              </div><img ng-if=\"section.arrangement === &quot;imageBanner&quot; &amp;&amp; section.images[0][0].filename\" ng-src=\"{{section.images[0][0].filename}}\">\n              <video ng-if=\"section.arrangement === &quot;videoBanner&quot; &amp;&amp; section.video[0].videoClipId\" controls vg-src=\"section.video[0].videoClipId | videoClipSrc\"></video>\n            </section>\n      <section class=\"row career-first-section\" id=\"career__jobs\" ng-if=\"campaigns &amp;&amp; campaigns.length\">\n        <div class=\"col-12\">\n          <div class=\"section-content section-spaced section-content--lg\">\n            <h1 class=\"section-title\">{{texts.career_our_jobs | translate}}</h1>\n            <div class=\"jobs__search\">\n              <div class=\"row justify-content-around\">\n                <div class=\"col-lg-4 search-centered\">\n                  <input class=\"search__title input-field input-field--search\" placeholder=\"{{texts.career_search_title | translate}}\" ng-model=\"search.main\">\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showCountries\">\n                  <ng-dropdown-multiselect class=\"search search__city\" ng-if=\"readyTobuildMultiSelect\" options=\"allCountries\" selected-model=\"search.countries\" extra-settings=\"multiselectSettings\" translation-texts=\"multiselectTextsCountries\"></ng-dropdown-multiselect>\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showCities\">\n                  <ng-dropdown-multiselect class=\"search search__city\" ng-if=\"readyTobuildMultiSelect\" options=\"filteredCities\" selected-model=\"search.city\" extra-settings=\"multiselectSettings\" translation-texts=\"multiselectTextsCities\"></ng-dropdown-multiselect>\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showCategories &amp;&amp; jobCategoryOptions &amp;&amp; jobCategoryOptions.length\">\n                  <ng-dropdown-multiselect class=\"search search__job-category\" id=\"jobCategoryDropdown\" ng-if=\"readyTobuildMultiSelectJobCategory\" options=\"jobCategoryOptions\" selected-model=\"search.jobCategories\" extra-settings=\"multiselectSettingsObj\" translation-texts=\"multiselectTextsJobCategory\" and-or-filter-inject=\"jobCategoryDropdown\" and-or-filter-match-all=\"search.jobCategoriesMatchAll\" and-or-filter-on-change=\"setJobCategoriesMatchAll($matchAll)\" and-or-filter-label-any=\"{{ texts.filter_match_any_category | translate }}\" and-or-filter-label-all=\"{{ texts.filter_match_all_categories | translate }}\"></ng-dropdown-multiselect>\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showNumberOfHoursPerWeek\">\n                  <ng-dropdown-multiselect class=\"search search__number-of-hours-per-week\" ng-if=\"readyTobuildMultiSelect\" options=\"numberOfHoursPerWeekOptions\" selected-model=\"search.numberOfHoursPerWeek\" extra-settings=\"multiselectSettings\" translation-texts=\"multiselectTextsNumberOfHoursPerWeek\"></ng-dropdown-multiselect>\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showContractType\">\n                  <ng-dropdown-multiselect class=\"search search__contract-type\" ng-if=\"readyTobuildMultiSelect\" options=\"contractTypeOptions\" selected-model=\"search.contractType\" extra-settings=\"multiselectSettings\" translation-texts=\"multiselectTextsContractType\"></ng-dropdown-multiselect>\n                </div>\n                <div class=\"col-lg-4 search-centered\" ng-if=\"employerBranding.careerPage.filters.showHomeWorkingPolicy\">\n                  <ng-dropdown-multiselect class=\"search search__home-working-policy\" ng-if=\"readyTobuildMultiSelect\" options=\"homeWorkingPolicyOptions\" selected-model=\"search.homeWorkingPolicy\" extra-settings=\"multiselectSettings\" translation-texts=\"multiselectTextsHomeWorkingPolicy\"></ng-dropdown-multiselect>\n                </div>\n              </div>\n            </div>\n            <div class=\"jobs__items\" ng-class=\"{ &quot;jobs__items--show-less&quot;: showLessCampaigns &amp;&amp; campaigns.length &gt; 6, &quot;jobs__items--show-more&quot;: !showLessCampaigns &amp;&amp; campaigns.length &gt; 6 }\" ng-style=\"{ &quot;max-height&quot;: !showLessCampaigns &amp;&amp; campaigns.length &gt; 6 ? campaignsMaxHeight : false }\"><a class=\"jobs__item bg lift-on-hover\" ng-repeat=\"campaign in campaigns\" ng-show=\"cityFilter(campaign) &amp;&amp; mainFilter(campaign) &amp;&amp; jobCategoryFilter(campaign) &amp;&amp; locationFilter(campaign) &amp;&amp; countriesFilter(campaign) &amp;&amp; numberOfHoursPerWeekFilter(campaign) &amp;&amp; contractTypeFilter(campaign) &amp;&amp; homeWorkingPolicyFilter(campaign)\" ng-href=\"{{campaign.inviteLink}}\" ng-class=\"{ &quot;bg--gradient-sky&quot;: !employerBranding.customization.mainColor }\" ng-style=\"{ &quot;background-color&quot;: employerBranding.customization.mainColor }\">\n                <div class=\"job__primary\">\n                  <div class=\"job__position\">{{campaign.title[visitorLang] || campaign.title[campaign.language]}}</div>\n                  <div class=\"job__city\">{{campaign.location.city}}</div>\n                </div>\n                <div class=\"job__secondary\">\n                  <div class=\"job__learn-more\">{{texts.career_learn_more | translate}}</div>\n                  <div class=\"job-categories__container\">\n                    <div class=\"badge badge--m badge--job-category badge--inline\" ng-if=\"campaign.jobCategories.length &gt; 0\" ng-style=\"{ border: '1px solid ' + employerBranding.customization.mainColor, color: employerBranding.customization.mainColor }\"><span title=\"{{campaign.jobCategories[0].label}}\">{{campaign.jobCategories[0].label}}</span></div>\n                    <div class=\"badge badge--m badge--job-category badge--inline\" ng-if=\"campaign.jobCategories.length &gt; 1\" ng-style=\"{ border: '1px solid ' + employerBranding.customization.mainColor, color: employerBranding.customization.mainColor }\" tooltips tooltip-template=\"{{campaign.jobCategoriesTooltip}}\" tooltip-side=\"bottom\"><span>+{{campaign.jobCategories.length - 1}}</span></div>\n                  </div>\n                </div></a></div><a class=\"jobs__items-btn-show show-more\" ng-if=\"campaigns.length &gt; 6\" ng-click=\"toggleCampaignsList()\" ng-class=\"{ &quot;show-more--closed&quot;: showLessCampaigns, &quot;show-more--open&quot;: !showLessCampaigns }\">{{ (showLessCampaigns ? texts.show_more : texts.show_less) | translate }}</a>\n            <div class=\"jobs__map\" ng-if=\"employerBranding.careerPage.filters.showMap\">\n              <div class=\"location-map\" id=\"job-locations__map\"></div>\n            </div>\n          </div>\n        </div>\n      </section>\n            <section class=\"career-section\" ng-repeat=\"section in employerBranding.careerPage.sections | filter: {location:&quot;beforeInfo&quot;} | filter:sectionExistsInVisitorLanguage | filter:{isPublished:true} track by $index\" ng-class=\"{&quot;career__banner-image&quot;: (section.arrangement === &quot;imageBanner&quot;), &quot;career__banner-video&quot;: (section.arrangement === &quot;videoBanner&quot;)}\">\n              <div class=\"scroll-anchor\" ng-attr-id=\"beforeInfo{{$index}}\"></div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;onlyMedia&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}} </h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-8 justify-content-center\"><img class=\"career__img\" ng-if=\"section.images[0][0].filename\" ng-src=\"{{section.images[0][0].filename}}\">\n                    <video class=\"career__video\" ng-if=\"section.video[0].videoClipId\" controls vg-src=\"section.video[0].videoClipId | videoClipSrc\"></video>\n                  </div>\n                </div>\n              </div>\n              <div class=\"container\" ng-if=\"section.arrangement === &quot;textThenMedia&quot;\">\n                <h1 class=\"career__title\">{{section.title | translate}}</h1>\n                <div class=\"row justify-content-center\">\n                  <div class=\"career__subsection col-12 col-lg-6 mb-3 mb-lg-0\">\n                    <div class=\"description__text\" ng-bind-html=\"section.text[visitorLang]\"></div>\n                  </div>\n                  <div class=\"career__subsection col-12 col-lg-6\"><img class=\"career__img\" ng-if=\"section.images[0][0].filename\" n