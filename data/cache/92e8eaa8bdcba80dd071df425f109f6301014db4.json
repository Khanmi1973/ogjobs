{"url": "https://jobs.saipem.com/", "status": 200, "text": " <!doctype html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"description\" content=\"\">\n    <title>Saipem - Job board</title>\n\n   <!-- <link rel=\"canonical\" href=\"https://getbootstrap.com/docs/5.1/examples/starter-template/\">-->\n\n\n    <!-- Bootstrap core CSS -->\n    <link href=\"css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"css/googleapis.css\" rel=\"stylesheet\">\n\t<link href=\"css/style.css\" rel=\"stylesheet\">\n\t<link href=\"css/flag-icons.min.css\" rel=\"stylesheet\">\n\n\n    <!-- Custom styles for this template -->\n    <link href=\"starter-template.css\" rel=\"stylesheet\">\n</head>\n<body>\n<div class=\"col-lg-12 mx-auto\">\n    <header class=\"align-items-center pb-2 mb-2\">\n        <div class=\"clearfix\"></div>\n    </header>\n    <main>\n        <div class=\"container\">\n            <div class=\"row my-5\">\n                <div class=\"col-3\">\n                    <div class=\"filters\">\n                        <div class=\"ui-group fullwidth\">\n                            <label id=\"labCountry\" class=\"labelSelects\">Country</label>\n                            <select id=\"selectco\" class=\"filter-select form-control\" value-group=\"testCo\">\n                            </select>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-3\">\n                    <div class=\"ui-group fullwidth\">\n                        <label id=\"labCompany\" class=\"labelSelects\">Company</label>\n                        <select id=\"selectcom\" class=\"filter-select form-control\" value-group=\"testCom\">\n                        </select>\n                    </div>\n                </div>\n                <div class=\"col-3\">\n                    <div class=\"ui-group fullwidth\">\n                        <label id=\"labType\" class=\"labelSelects\">Business type</label>\n                        <select id=\"selectjf\" class=\"filter-select form-control\" value-group=\"testJF\">\n                        </select>\n                    </div>\n                </div>\n                <div class=\"col-3\">\n                    <div class=\"filters form-group fullwidth\">\n                        <label id=\"labSearch\" class=\"labelSelects\">Search</label>\n                        <input type=\"text\" id=\"searchposition\" class=\"quicksearch form-control\" placeholder=\"Search position\"/>\n                    </div>\n                </div>\n            </div>\n        </div>\n       \t<div class=\"container\" id=\"saipemspa_alert\">\n    \t\t<div class=\"row my-5\" id=\"saipemspa_alert_int\">\n    \t\t\t<div id=\"saipemspa_alert_internal\" class=\"col-12\">\n    \t\t\t\t<p><b>List of positions under maintenance. For complete list of positions please refer to Linkedin Saipem SpA Page.</b></p>\n    \t\t\t</div>\n    \t\t</div>\n    \t</div>\n        <div class=\"container\">\n            <div class=\"row grid\" id=\"positionsContainer\">\n            </div>\n        </div>\n\n    </main>\n    <footer class=\"py-5 text-center\">\n        nCore for Saipem &middot; &copy;\n    </footer>\n    <!-- Button trigger modal -->\n\n    <!-- Modal -->\n    <div class=\"modal fade\" id=\"descModal\" tabindex=\"-1\" aria-labelledby=\"descModalLabel\" aria-hidden=\"true\">\n        <div class=\"modal-dialog modal-xl\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\" id=\"descModalLabel\"></h5>\n                    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <div>\n                        <ul class=\"setInfo\"><li class=\"liCountry\" id=\"modal_country_text\"></li><li class=\"liCompany\" id=\"modal_company_text\"></li><li class=\"liType\" id=\"modal_type_text\"></li></ul>\n                        <p id=\"textModalLabel\"></p>\n                    </div>\n                </div>\n                <div class=\"modal-footer\">\n                   <!-- <button type=\"button\" class=\"btn btnCandidati\">Apply now</button>-->\n                \t<a id=\"modal_apply_button\" href=\"\" target=\"_blank\" class=\"btn btnCandidati\" role=\"button\">Apply now</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<script src=\"js/bootstrap.bundle.min.js\"></script>\n\n<script src=\"/js/jquery.min.js\"></script>\n<script src=\"/js/isotope.pkgd.min.js\"></script>\n<script src=\"/js/main.js\"></script>\n\n\n</body>\n</html>", "headers": {"date": "Fri, 21 Aug 2026 12:35:25 GMT", "server": "Apache", "strict-transport-security": "max-age=31536000; includeSubdomains; preload", "x-frame-options": "DENY", "x-content-type-options": "nosniff", "x-permitted-cross-domain-policies": "none", "referrer-policy": "no-referrer", "cross-origin-opener-policy": "same-origin", "cross-origin-resource-policy": "same-origin", "cache-control": "no-store, max-age=0", "content-security-policy": "default-src 'self'; img-src 'self' data:; font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests;", "upgrade": "h2,h2c", "connection": "Upgrade, close", "last-modified": "Tue, 28 Oct 2025 11:14:51 GMT", "etag": "\"11d1-642361fe9f7eb\"", "accept-ranges": "bytes", "content-length": "4561", "content-type": "text/html; charset=UTF-8"}}